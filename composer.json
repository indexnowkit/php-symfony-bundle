{
    "name": "indexnowkit/symfony-bundle",
    "description": "Symfony bundle for IndexNow: notify Yandex, Bing, Naver and Seznam when Doctrine entities change. Attribute on entity, Messenger dispatch, key file route, console commands.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["indexnow", "symfony", "symfony-bundle", "doctrine", "seo", "yandex", "bing", "messenger"],
    "homepage": "https://indexnowkit.dev/php/symfony",
    "require": {
        "php": "^8.2",
        "indexnowkit/core": "^0.1",
        "indexnowkit/doctrine": "^0.1",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/routing": "^6.4 || ^7.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0"
    },
    "suggest": {
        "symfony/messenger": "Async dispatch with retries (dispatch: messenger)",
        "doctrine/doctrine-bundle": "Automatic entity change detection",
        "symfony/http-client": "PSR-18 client for outgoing requests",
        "nyholm/psr7": "PSR-17 factories for symfony/http-client"
    },
    "autoload": {
        "psr-4": {"IndexNowKit\\SymfonyBundle\\": "src/"}
    },
    "extra": {
        "branch-alias": {"dev-main": "0.1-dev"}
    }
}
