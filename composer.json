{
    "name": "indexnowkit/symfony-bundle",
    "description": "Symfony bundle for IndexNow: notify Yandex, Bing, Naver, Seznam and Yep when Doctrine entities change. #[IndexNow] rules on entities, commit-safe Doctrine hooks, Messenger dispatch, key file route, console commands, profiler panel.",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Igor Pinchuk",
            "email": "i.pinchuk.work@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "keywords": [
        "indexnow",
        "symfony",
        "symfony-bundle",
        "doctrine",
        "seo",
        "yandex",
        "bing",
        "messenger",
        "psr-18",
        "psr-3"
    ],
    "homepage": "https://indexnowkit.github.io/php/symfony-bundle/",
    "support": {
        "issues": "https://github.com/indexnowkit/php/issues",
        "source": "https://github.com/indexnowkit/php-symfony-bundle",
        "docs": "https://github.com/indexnowkit/php-symfony-bundle/blob/main/README.md",
        "security": "https://github.com/indexnowkit/php-symfony-bundle/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "indexnowkit/core": "^0.6",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0",
        "symfony/framework-bundle": "^6.4 || ^7.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4.13 || ^7.0",
        "symfony/routing": "^6.4 || ^7.0"
    },
    "require-dev": {
        "doctrine/dbal": "^3.8 || ^4.0",
        "doctrine/doctrine-bundle": "^2.13 || ^3.0",
        "doctrine/orm": "^2.19 || ^3.0",
        "doctrine/persistence": "^3.0 || ^4.0",
        "indexnowkit/doctrine": "^0.4",
        "indexnowkit/sitemap": "^0.2",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.2.13",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "phpunit/phpunit": "^11.5",
        "roave/security-advisories": "dev-latest",
        "symfony/browser-kit": "^6.4 || ^7.0",
        "symfony/error-handler": "^6.4.44 || ^7.0",
        "symfony/http-client": "^6.4 || ^7.0",
        "symfony/messenger": "^6.4 || ^7.0",
        "symfony/twig-bundle": "^6.4 || ^7.0",
        "symfony/web-profiler-bundle": "^6.4 || ^7.0",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "suggest": {
        "indexnowkit/sitemap": "The indexnow:sitemap command (^0.2)",
        "indexnowkit/doctrine": "Automatic submission when Doctrine entities change (^0.4, together with doctrine/doctrine-bundle)",
        "doctrine/doctrine-bundle": "Required with indexnowkit/doctrine (^2.13 || ^3.0)",
        "symfony/messenger": "Async dispatch with retries (dispatch: messenger, ^6.4 || ^7.0)",
        "symfony/http-client": "HTTP client for outgoing requests (wrapped as PSR-18 automatically)",
        "nyholm/psr7": "PSR-17 factories for symfony/http-client",
        "symfony/web-profiler-bundle": "IndexNow panel in the Web Profiler"
    },
    "autoload": {
        "psr-4": {
            "IndexNowKit\\SymfonyBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IndexNowKit\\SymfonyBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "ci:install:highest": "@composer update --no-interaction --prefer-dist",
        "ci:install:lowest": "@composer update --no-interaction --prefer-dist --prefer-lowest --prefer-stable",
        "ci:install:symfony64": "@composer update --no-interaction --prefer-dist --with symfony/framework-bundle:^6.4 --with doctrine/dbal:^3.8 --with doctrine/orm:^2.19"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.7.x-dev"
        }
    }
}
