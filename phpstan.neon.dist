# Level 9 with phpstan-strict-rules; the monorepo CI runs this same file per package.
includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
parameters:
    level: 9
    paths:
        - src
        - config
    # The service()/service_closure()/tagged_iterator() helpers live in this class file; static reflection only sees
    # them once the file is scanned, whichever worker analyses the loader first.
    scanFiles:
        - vendor/symfony/dependency-injection/Loader/Configurator/ContainerConfigurator.php
    treatPhpDocTypesAsCertain: false
    # The lowest flavour runs on Symfony 6.4, whose stubs lack the generics and signatures of 7.x; the inline ignores for it are unmatched on 7.x.
    reportUnmatchedIgnoredErrors: false
