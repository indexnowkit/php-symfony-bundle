<?xml version="1.0" encoding="UTF-8"?>
<!-- Standalone configuration for the split repository (indexnowkit/php-symfony-bundle). The monorepo uses php/phpunit.xml.dist. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php" colors="true" failOnWarning="true" failOnDeprecation="false" cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="symfony-bundle"><directory>tests</directory></testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <env name="KERNEL_CLASS" value="IndexNowKit\SymfonyBundle\Tests\App\TestKernel"/>
        <env name="APP_ENV" value="test"/>
        <env name="APP_DEBUG" value="0"/>
    </php>
</phpunit>
