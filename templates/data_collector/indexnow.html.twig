{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block toolbar %}
    {% set icon %}
        <span class="icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3M8 11h6M11 8v6"/></svg></span>
        <span class="sf-toolbar-value">{{ collector.sent }}</span>
        <span class="sf-toolbar-label">IndexNow</span>
    {% endset %}
    {% set text %}
        <div class="sf-toolbar-info-piece"><b>Collected</b><span>{{ collector.collected }}</span></div>
        <div class="sf-toolbar-info-piece"><b>Sent</b><span>{{ collector.sent }}</span></div>
        <div class="sf-toolbar-info-piece"><b>Failed</b><span class="sf-toolbar-status {{ collector.failed ? 'sf-toolbar-status-red' }}">{{ collector.failed }}</span></div>
        <div class="sf-toolbar-info-piece"><b>Dispatch</b><span>{{ collector.dispatch }}{{ collector.dryRun ? ' (dry run)' }}</span></div>
    {% endset %}
    {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', { link: profiler_url, status: collector.failed ? 'red' : (collector.enabled ? '' : 'yellow') }) }}
{% endblock %}

{% block menu %}
    <span class="label {{ collector.failed ? 'label-status-error' }}">
        <span class="icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3M8 11h6M11 8v6"/></svg></span>
        <strong>IndexNow</strong>
        {% if collector.failed %}<span class="count"><span>{{ collector.failed }}</span></span>{% endif %}
    </span>
{% endblock %}

{% block panel %}
    <h2>IndexNow</h2>
    <div class="metrics">
        <div class="metric"><span class="value">{{ collector.collected }}</span><span class="label">URLs collected</span></div>
        <div class="metric"><span class="value">{{ collector.sent }}</span><span class="label">URLs accepted</span></div>
        <div class="metric"><span class="value">{{ collector.failed }}</span><span class="label">Failed requests</span></div>
        <div class="metric"><span class="value">{{ collector.dispatch }}</span><span class="label">Dispatch</span></div>
    </div>
    <p>Engines: {{ collector.engines|join(', ') }}{% if collector.dryRun %} · <strong>dry run</strong>{% endif %}{% if not collector.enabled %} · <strong>disabled</strong>{% endif %}</p>
    {% if collector.dispatch == 'messenger' %}
        <p class="help">URLs were dispatched to Messenger; HTTP results appear in the worker logs (channel <code>indexnow</code>).</p>
    {% endif %}
    {% if collector.results is empty %}
        <div class="empty"><p>No IndexNow request was sent during this request.</p></div>
    {% else %}
        <table>
            <thead><tr><th>Engine</th><th>Host</th><th>Status</th><th>HTTP</th><th>URLs</th></tr></thead>
            <tbody>
            {% for r in collector.results %}
                <tr>
                    <td>{{ r.engine }}</td>
                    <td>{{ r.host }}</td>
                    <td><span class="label {{ r.status == 'failed' ? 'status-error' : 'status-success' }}">{{ r.status }}</span>{% if r.error %} <small>{{ r.error }}</small>{% endif %}</td>
                    <td>{{ r.http ?? '-' }}</td>
                    <td><ul>{% for u in r.urls %}<li>{{ u }}</li>{% endfor %}</ul></td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
